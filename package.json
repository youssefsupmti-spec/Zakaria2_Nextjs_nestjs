{
  "name": "@zakaria/source",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "nx run-many -t serve -p api web --parallel=2",
    "dev:web": "nx run web:serve",
    "dev:api": "nx run api:serve",
    "dev:worker": "nx run worker:serve",
    "build": "nx run-many -t build -p api worker web",
    "typecheck": "nx run-many -t typecheck -p contracts backend-config database api worker web",
    "db:generate": "prisma generate --config=libs/backend/database/prisma.config.ts --schema=libs/backend/database/prisma/schema.prisma",
    "db:validate": "prisma validate --config=libs/backend/database/prisma.config.ts --schema=libs/backend/database/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --config=libs/backend/database/prisma.config.ts",
    "db:migrate:status": "prisma migrate status --config=libs/backend/database/prisma.config.ts",
    "db:seed:prod-users": "tsx libs/backend/database/scripts/migrate-prod-mysql-to-pg.ts",
    "test:auth": "tsx --tsconfig tsconfig.base.json --test apps/api/test/auth.spec.ts",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@hookform/resolvers": "7.0.5",
    "@nestjs/bullmq": "12.0.1",
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-fastify": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "6.7.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.10",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "lucide-react": "1.71.0",
    "mysql2": "^3.24.6",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nx/js": "24.0.6",
    "@nx/nest": "24.0.6",
    "@nx/next": "24.0.6",
    "@nx/node": "24.0.6",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "nx": "24.0.6",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
