{
  "name": "@zakaria/source",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "nx run-many -t serve -p api web --parallel=2",
    "dev:web": "nx run web:serve",
    "dev:api": "nx run api:serve",
    "dev:worker": "nx run worker:serve",
    "build": "nx run-many -t build -p api worker web",
    "typecheck": "nx run-many -t typecheck -p contracts backend-config database api worker web",
    "lint": "eslint apps libs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "openapi:generate": "tsx --tsconfig tsconfig.base.json apps/api/src/scripts/generate-openapi.ts",
    "db:generate": "prisma generate --config=libs/backend/database/prisma.config.ts --schema=libs/backend/database/prisma/schema.prisma",
    "db:validate": "prisma validate --config=libs/backend/database/prisma.config.ts --schema=libs/backend/database/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --config=libs/backend/database/prisma.config.ts",
    "db:migrate:status": "prisma migrate status --config=libs/backend/database/prisma.config.ts",
    "db:seed:prod-users": "tsx --tsconfig tsconfig.base.json libs/backend/database/scripts/migrate-prod-mysql-to-pg.ts",
    "db:seed:prod-sprint03": "tsx --tsconfig tsconfig.base.json libs/backend/database/scripts/migrate-prod-sprint03-to-pg.ts",
    "db:rbac:reconcile": "tsx --tsconfig tsconfig.base.json libs/backend/database/scripts/reconcile-rbac-d07-d15.ts",
    "test:auth": "vitest run apps/api/test/auth.spec.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@hookform/resolvers": "7.0.5",
    "@iconify-json/solar": "^1.2.15",
    "@iconify/react": "^6.0.4",
    "@nestjs/bullmq": "12.0.1",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-fastify": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^9.3.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "6.7.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.10",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "lucide-react": "1.71.0",
    "nestjs-pino": "^5.3.1",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "pg": "8.23.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fastify/static": "^10.1.10",
    "@nestjs/testing": "^12.4.2",
    "@nx/js": "24.0.6",
    "@nx/nest": "24.0.6",
    "@nx/next": "24.0.6",
    "@nx/node": "24.0.6",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "mysql2": "^3.24.6",
    "nx": "24.0.6",
    "openapi-typescript": "^7.13.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "swagger-ui-dist": "^5.34.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
