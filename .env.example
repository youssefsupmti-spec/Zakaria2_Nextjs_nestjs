# ==============================================================================
# ZAKARIA2 (G4D — GROUP FOR DELIVERY) — CONFIGURATION ENVIRONNEMENT SPRINT 01
# ==============================================================================

NODE_ENV=development

# Ports isolés (évite toute collision avec le port 3000)
WEB_PORT=3100
API_PORT=3101
API_HOST=0.0.0.0

# URLs publiques et CORS
NEXT_PUBLIC_APP_NAME="G4D — Group For Delivery"
NEXT_PUBLIC_API_URL="http://localhost:3101/api/v1"
CORS_ORIGINS="http://localhost:3100"

# Base de données PostgreSQL 18 locale
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zakaria2_next_dev?schema=public"

# File d'attente Redis / BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PREFIX=zakaria2

