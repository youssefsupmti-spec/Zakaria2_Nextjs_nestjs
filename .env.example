# ══════════════════════════════════════════════════════════════════════════════
# G4D — Variables d'environnement (Développement Local & Production Dokploy)
# ══════════════════════════════════════════════════════════════════════════════

# ── Environnement Général ──
NODE_ENV=development
WEB_PORT=3100
API_PORT=3101
API_HOST=0.0.0.0
CORS_ORIGINS=https://app.g4dmaroc.xyz,https://api.g4dmaroc.xyz,http://localhost:3100

# ── Frontend (Next.js) ──
NEXT_PUBLIC_API_URL=http://localhost:3101/api/v1
# En production sur Dokploy (app.g4dmaroc.xyz) :
# NEXT_PUBLIC_API_URL=https://api.g4dmaroc.xyz/api/v1

# ── Base de données PostgreSQL ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zakaria2_next_dev?schema=public
# En production sur Dokploy : définir DATABASE_URL dans les variables sécurisées Dokploy (jamais en clair ici).

# ── Cache & Files d'attente Redis (Séparation Cache LRU vs Queue noeviction) ──
REDIS_CACHE_URL=redis://127.0.0.1:56379
REDIS_QUEUE_URL=redis://127.0.0.1:56380
# Compatibilité mono-instance fallback (optionnel si REDIS_CACHE_URL/REDIS_QUEUE_URL fournis) :
REDIS_URL=redis://127.0.0.1:56380
REDIS_HOST=127.0.0.1
REDIS_PORT=56380
REDIS_PREFIX=zakaria2

# ── Authentification, CSRF & Sessions (Sprint 02 + Lot 2.5) ──
AUTH_COOKIE_NAME=g4d.session
# En production HTTPS : AUTH_COOKIE_NAME=__Host-g4d.session
AUTH_SECRET=remplacer-par-secret-aleatoire-64-caracteres
CSRF_SECRET=remplacer-par-secret-csrf-aleatoire-64-caracteres
API_SECRET_PEPPER=remplacer-par-pepper-hmac-api-keys-64-caracteres
APP_PUBLIC_URL=http://localhost:3100
API_INTERNAL_URL=http://127.0.0.1:3101

# ── Stockage local VPS (Lot 2.5) & Documentation OpenAPI ──
STORAGE_LOCAL_PATH=./storage/uploads
SWAGGER_ENABLED=true

# ── Messagerie SMTP / Worker BullMQ (Mailpit dans compose.dev.yaml en dev uniquement) ──
# En production : définir MAIL_HOST, MAIL_PORT, MAIL_SECURE, MAIL_USER, MAIL_PASS, MAIL_FROM dans Dokploy.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="G4D Delivery <no-reply@g4dmaroc.xyz>"

# ── Source MySQL Legacy pour ETL Users/RBAC (uniquement pendant la migration) ──
# LEGACY_MYSQL_URL=mysql://<USER>:<PASSWORD>@<HOST>:3306/<DATABASE>
