# ══════════════════════════════════════════════════════════════════════════════
# G4D — Variables d'environnement (Développement Local & Production Dokploy)
# ══════════════════════════════════════════════════════════════════════════════

# ── Environnement Général ──
NODE_ENV=development
WEB_PORT=3100
API_PORT=3101
API_HOST=0.0.0.0
CORS_ORIGINS=https://app.g4dmaroc.xyz,https://api.g4dmaroc.xyz,http://localhost:3100

# ── Frontend (Next.js) ──
NEXT_PUBLIC_API_URL=http://localhost:3101/api/v1
# En production sur Dokploy (app.g4dmaroc.xyz) :
# NEXT_PUBLIC_API_URL=https://api.g4dmaroc.xyz/api/v1

# ── Base de données PostgreSQL ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zakaria2_next_dev?schema=public
# En production sur Dokploy (nestjsnextjs-database-mujw4w) :
# DATABASE_URL=postgresql://postgres:cbln6b6dcoghkpva@nestjsnextjs-database-mujw4w:5432/postgres

# ── Cache & Files d'attente Redis (BullMQ) ──
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PREFIX=zakaria2
# En production sur Dokploy (nestjsnextjs-reduis-cksyka) :
# REDIS_URL=redis://default:hfvzvp2saihxz7pc@nestjsnextjs-reduis-cksyka:6379
